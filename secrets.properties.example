# Optional: copy to "secrets.properties" (gitignored) to bake default API keys
# into the build so the app comes pre-filled on a fresh install. Leave blank to
# just type the key in the app once (it's then stored encrypted on the device).
#
# These are compiled into the APK. Only use this for your own personal builds;
# never commit real keys, and remember an APK can be decompiled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
