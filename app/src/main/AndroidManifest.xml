<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+ requires runtime permission to post the Android Auto chat notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoDriver">

        <!-- Android Auto messaging: the assistant appears as a conversation whose
             messages the car reads aloud, with a voice reply. This is the whole
             Android Auto integration, and it is passive - the app runs no code
             while the car connects, so it never interferes with Android Auto startup. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Phone companion: settings + "test & speak" + Driving Mode. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen hands-light assistant for a phone mount. -->
        <activity
            android:name=".DrivingModeActivity"
            android:exported="false"
            android:label="Driving Mode"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <!-- Receives spoken replies from the Android Auto messaging UI. -->
        <receiver
            android:name=".car.MessageReplyReceiver"
            android:exported="false" />
    </application>
</manifest>
